{
  "lexicon": 1,
  "id": "place.selfhost.instance",
  "defs": {
    "main": {
      "type": "record",
      "description": "A self-hosted AT Protocol instance advertisement. Latest-wins per PDS (record key 'self').",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["name", "pds", "createdAt"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The instance display name."
          },
          "description": {
            "type": "string",
            "maxLength": 512,
            "description": "A short human-readable description."
          },
          "pds": {
            "type": "string",
            "format": "uri"
          },
          "relay": {
            "type": "string",
            "format": "uri"
          },
          "appview": {
            "type": "string",
            "format": "uri"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
