{
  "lexicon": 1,
  "id": "place.selfhost.status",
  "defs": {
    "main": {
      "type": "record",
      "description": "A single-emoji presence status. Latest-wins per account (record key 'self').",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["status", "createdAt"],
        "properties": {
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "maxGraphemes": 1,
            "description": "The emoji status."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
