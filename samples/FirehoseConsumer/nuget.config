<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The published package feed is the normal path. Configure credentials for the `github` source
    with a Personal Access Token (read:packages), as described in ../../docs/packaging.md.
    A local feed remains available for offline development when populated as described in README.md.
  -->
  <packageSources>
    <clear />
    <add key="github" value="https://nuget.pkg.github.com/luisquintanilla/index.json" />
    <add key="local" value="./local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
