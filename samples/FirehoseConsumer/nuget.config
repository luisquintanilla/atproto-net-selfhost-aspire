<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Default: consume the packages from a local feed you produce with `dotnet pack` (see README.md).
    This needs no authentication and works offline, which is the easiest way to try the sample.

    To consume the real published packages from GitHub Packages instead, add that source with a
    Personal Access Token (read:packages) as described in ../../docs/packaging.md, for example:

      <add key="github" value="https://nuget.pkg.github.com/luisquintanilla/index.json" />

    (GitHub Packages requires authentication even for public packages, hence the local-feed default.)
  -->
  <packageSources>
    <clear />
    <add key="local" value="./local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
