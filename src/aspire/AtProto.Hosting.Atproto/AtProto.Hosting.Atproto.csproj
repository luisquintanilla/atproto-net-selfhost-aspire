<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHostingIntegration>true</IsAspireHostingIntegration>
    <IsPackable>true</IsPackable>
    <Description>.NET Aspire hosting integration to run a self-hosted AT Protocol stack (PDS, Relay, AppView). Part of the atproto-net-selfhost-aspire stack.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

</Project>
